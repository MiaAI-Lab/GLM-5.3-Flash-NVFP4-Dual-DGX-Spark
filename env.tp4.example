# Copy to .env.tp4 (gitignored) and fill in YOUR 4-Spark switched fabric.
# Then:  ./start-tp4.sh
#
# EXPERIMENTAL. Never tested on this kit (we only have 2 Sparks).
# Requires a RoCE L2 switch (or equivalent) so every CX7 is on the same
# subnet. A switchless QSFP ring needs a different stack — see
# https://github.com/alexellis/glm-5.3-flash-4x-dgx-spark-switchless
#
# HEAD_IP and WORKER*_IP must be the addresses on the CX7 / RoCE NICs
# (the IPs bound to HEAD_CX7_IF / WORKER*_CX7_IF), not the 1 GbE
# management LAN. Ray may tolerate a management IP; NCCL will hang in
# ncclCommInitRank if you pin the wrong NIC.

# --- head (this machine, rank 0) ---
HEAD_IP=10.10.0.1
HEAD_CX7_IF=enp1s0f0np0
HEAD_CX7_IB=rocep1s0f0

# --- workers (ranks 1, 2, 3) ---
# SSH user@host, RoCE IP, CX7 netdev, IB HCA. HOME defaults to /home/<ssh-user>.
WORKER1_SSH=spark2@10.10.0.2
WORKER1_IP=10.10.0.2
WORKER1_CX7_IF=enp1s0f0np0
WORKER1_CX7_IB=rocep1s0f0
# WORKER1_HOME=/home/spark2

WORKER2_SSH=spark3@10.10.0.3
WORKER2_IP=10.10.0.3
WORKER2_CX7_IF=enp1s0f0np0
WORKER2_CX7_IB=rocep1s0f0

WORKER3_SSH=spark4@10.10.0.4
WORKER3_IP=10.10.0.4
WORKER3_CX7_IF=enp1s0f0np0
WORKER3_CX7_IB=rocep1s0f0

# Optional. GPU_MEM_UTIL=0.84 was tuned for TP=2 UMA; TP=4 shards weights
# more so you may have room to raise it. Leave it unless /health OOMs.
# GPU_MEM_UTIL=0.84
# PORT=8888
# MAX_MODEL_LEN=262144
